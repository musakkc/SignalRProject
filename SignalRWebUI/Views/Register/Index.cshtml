@model RegisterDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html>

@await Component.InvokeAsync("_UILayoutHeadComponentPartial")

<body class="sub_page">

    @await Component.InvokeAsync("_MenuNavbarComponentPartial")

    <section class="book_section layout_padding" style="min-height: 80vh;">
        <div class="container">
            <div class="heading_container heading_center">
                <h2>
                    Kayıt Ol
                </h2>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-5">
                    <div class="card shadow-lg border-0" style="border-radius: 15px; overflow: hidden;">
                        <div class="card-header text-center py-4" style="background: linear-gradient(135deg, #ffbe33 0%, #ff9900 100%);">
                            <h3 class="text-white mb-0">
                                <i class="fa fa-user-plus fa-2x mb-2"></i><br>
                                MK Restoran
                            </h3>
                        </div>
                        <div class="card-body p-5">
                            <form method="post">
                                <div class="form-group mb-3">
                                    <label for="Name" class="form-label fw-bold">
                                        <i class="fa fa-user"></i> Adınız
                                    </label>
                                    <input type="text" asp-for="Name" class="form-control form-control-lg" 
                                           placeholder="Adınızı giriniz" required 
                                           style="border-radius: 10px; border: 2px solid #ddd;">
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label for="Surname" class="form-label fw-bold">
                                        <i class="fa fa-user"></i> Soyadınız
                                    </label>
                                    <input type="text" asp-for="Surname" class="form-control form-control-lg" 
                                           placeholder="Soyadınızı giriniz" required 
                                           style="border-radius: 10px; border: 2px solid #ddd;">
                                    <span asp-validation-for="Surname" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label for="Username" class="form-label fw-bold">
                                        <i class="fa fa-at"></i> Kullanıcı Adı
                                    </label>
                                    <input type="text" asp-for="Username" class="form-control form-control-lg" 
                                           placeholder="Kullanıcı adınızı giriniz" required 
                                           style="border-radius: 10px; border: 2px solid #ddd;">
                                    <span asp-validation-for="Username" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label for="Mail" class="form-label fw-bold">
                                        <i class="fa fa-envelope"></i> E-posta
                                    </label>
                                    <input type="email" asp-for="Mail" class="form-control form-control-lg" 
                                           placeholder="E-posta adresinizi giriniz" required 
                                           style="border-radius: 10px; border: 2px solid #ddd;">
                                    <span asp-validation-for="Mail" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-4">
                                    <label for="Password" class="form-label fw-bold">
                                        <i class="fa fa-lock"></i> Şifre
                                    </label>
                                    <input type="password" asp-for="Password" class="form-control form-control-lg" 
                                           placeholder="Şifrenizi giriniz" required
                                           style="border-radius: 10px; border: 2px solid #ddd;">
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                    <small class="form-text text-muted mt-2">
                                        <i class="fa fa-info-circle"></i> En az 6 karakter, büyük harf, küçük harf, rakam ve özel karakter içermelidir.
                                    </small>
                                </div>
                                <div class="d-grid gap-2 mt-4">
                                    <button type="submit" class="btn btn-lg text-white" 
                                            style="background: linear-gradient(135deg, #ffbe33 0%, #ff9900 100%); border-radius: 10px; font-weight: bold;">
                                        <i class="fa fa-user-plus"></i> Kayıt Ol
                                    </button>
                                </div>
                            </form>
                            <hr class="my-4">
                            <div class="text-center">
                                <span class="text-muted">Zaten hesabınız var mı?</span>
                                <a href="/Login/Index" class="ms-2" style="color: #ffbe33; font-weight: bold;">
                                    Giriş Yap
                                </a>
                            </div>
                            <div class="text-center mt-2">
                                <a href="/Default/Index" class="text-muted">
                                    <i class="fa fa-arrow-left"></i> Ana Sayfaya Dön
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Password Validation Error Modal -->
        <div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius: 15px; border: none;">
                    <div class="modal-header" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%); border-radius: 15px 15px 0 0;">
                        <h5 class="modal-title text-white" id="errorModalLabel">
                            <i class="fa fa-exclamation-triangle"></i> Şifre Gereksinimleri Karşılanmadı
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div id="errorList" class="mb-3">
                            <!-- Errors will be inserted here by JavaScript -->
                        </div>
                        <hr>
                        <h6 class="mb-3"><i class="fa fa-info-circle text-primary"></i> Şifre Gereksinimleri:</h6>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="fa fa-check text-success"></i> En az 6 karakter uzunluğunda olmalı</li>
                            <li class="mb-2"><i class="fa fa-check text-success"></i> En az bir büyük harf içermeli (A-Z)</li>
                            <li class="mb-2"><i class="fa fa-check text-success"></i> En az bir küçük harf içermeli (a-z)</li>
                            <li class="mb-2"><i class="fa fa-check text-success"></i> En az bir rakam içermeli (0-9)</li>
                            <li class="mb-2"><i class="fa fa-check text-success"></i> En az bir özel karakter içermeli (!#$%^&*)</li>
                        </ul>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @await Component.InvokeAsync("_UILayoutFooterComponentPartial")

    @await Component.InvokeAsync("_UILayoutScriptComponentPartial")

    @if (TempData["Errors"] != null)
    {
        var errors = TempData["Errors"].ToString();
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var errors = '@Html.Raw(errors)'.split('|');
                var errorListDiv = document.getElementById('errorList');
                
                if (errors.length > 0 && errors[0] !== '') {
                    var errorHtml = '<div class="alert alert-danger" role="alert">';
                    errorHtml += '<strong><i class="fa fa-times-circle"></i> Tespit Edilen Hatalar:</strong>';
                    errorHtml += '<ul class="mt-2 mb-0">';
                    errors.forEach(function(error) {
                        if (error.trim() !== '') {
                            errorHtml += '<li>' + error + '</li>';
                        }
                    });
                    errorHtml += '</ul></div>';
                    
                    errorListDiv.innerHTML = errorHtml;
                    
                    // Show the modal using Bootstrap 5
                    var errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                    errorModal.show();
                }
            });
        </script>
    }

</body>

</html>